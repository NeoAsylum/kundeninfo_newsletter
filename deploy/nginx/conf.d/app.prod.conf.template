# PROD: TLS-Terminierung mit Konzern-Zertifikat (ro-Mounts aus compose.prod.yaml).
# Unbekannte Hostnamen zuerst abweisen: Ohne diesen Block landet jeder Host-Header
# im Serverblock darunter und damit in der Weiterleitung. $host käme dann aus der
# Anfrage — ein vorgelagerter Cache könnte die vergiftete Weiterleitung an echte
# Nutzer ausliefern. Der öffentliche Stack macht das seit jeher so.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    # Der Container-Healthcheck spricht 127.0.0.1 an und trägt keinen bekannten Host.
    location = /nginx-health { access_log off; return 200 "ok\n"; }
    return 421;
}

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    # $server_name statt $host: die Weiterleitung zeigt immer auf die konfigurierte
    # Adresse, nie auf einen vom Client behaupteten Hostnamen.
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # HSTS und die übrigen Sicherheits-Header kommen aus security-headers.inc und
    # werden pro Location gesetzt — siehe Kommentar in app-locations.inc.
    include /etc/nginx/includes/app-locations.inc;
}
