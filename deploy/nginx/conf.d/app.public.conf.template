# Vorlage für den öffentlichen Betrieb. ${PUBLIC_HOST} wird beim Containerstart
# ersetzt (nginx envsubst-Template-Mechanik).

# Unbekannte Hostnamen (direkte IP-Aufrufe, fremde Domains, Scanner) hart abweisen,
# damit sie nicht auf dem Portal landen.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Der Container-Healthcheck ruft http://127.0.0.1/nginx-health auf — sein
    # Host-Header ist die IP, nicht die Domain, er landet also hier. Ohne diese
    # Location gälte der Container dauerhaft als ungesund.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 421;
    }
}

# HTTP für die eigene Domain: ausschließlich ACME-Challenge, Health-Stub und
# Weiterleitung auf HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Für den Container-Healthcheck: Er läuft gegen Port 80 und darf keinen
    # Redirect bekommen, sonst gilt der Container dauerhaft als ungesund.
    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
